<%- include('partials/header') %>

<div id="toast" class="toast hidden">
  <span id="toastMessage"></span>
  <button type="button" onclick="closeToast()">×</button>
</div>

<div class="thank">
  <span class="eyebrow">Success</span>

  <h1>🎉 Cảm ơn quý khách!</h1>

  <p>
    Thanh toán thành công. Đơn hàng đã lưu vào database,
    doanh thu đã ghi nhận và điểm thưởng sẽ tự động cộng vào tài khoản.
  </p>

  <div class="actions">
    <% if (orderId) { %>
      <a class="btn" href="/orders/<%= orderId %>/invoice">Xuất hóa đơn</a>
      <a class="btn light" href="/orders/<%= orderId %>">Xem đơn hàng</a>
    <% } %>

    <a class="btn light" href="/customer">Về màn hình chính</a>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    showToast('Thanh toán thành công. Đơn hàng đã được ghi nhận.', 'success');
  });
</script>

<%- include('partials/footer') %>