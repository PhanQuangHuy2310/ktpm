<%- include('partials/header') %>

<section class="page-head">
  <div>
    <span class="eyebrow">Checkout</span>
    <h1>Xác nhận thanh toán</h1>
    <p>Kiểm tra lại thông tin đơn hàng trước khi thanh toán.</p>
  </div>
</section>

<div id="toast" class="toast hidden">
  <span id="toastMessage"></span>
  <button type="button" onclick="closeToast()">×</button>
</div>

<div class="checkout-card">
  <div>
    <h2>Đơn hàng tại <%= order.branch_name %></h2>

    <p>
      <b>Khách hàng:</b>
      <%= order.customer_name %> - <%= order.customer_phone %>
    </p>

    <p>
      <b>Địa chỉ nhận:</b>
      <%= order.delivery_address %>
    </p>

    <p>
      <b>Thời gian tạo:</b>
      <%= new Date(order.created_at).toLocaleString('vi-VN', {
        timeZone: 'Asia/Ho_Chi_Minh',
        hour12: false
      }) %>
    </p>
  </div>

  <div class="total-box">
    <span>Phải thanh toán</span>
    <b><%= Number(order.final_amount || order.total_amount).toLocaleString('vi-VN') %>đ</b>
  </div>
</div>

<table>
  <tr>
    <th>Tên sản phẩm</th>
    <th>SL</th>
    <th>Đơn giá</th>
    <th>Thành tiền</th>
  </tr>

  <% order.items.forEach(i => { %>
    <tr>
      <td><%= i.item_name %></td>

      <td>
        <span class="badge"><%= i.quantity %></span>
      </td>

      <td>
        <%= Number(i.unit_price).toLocaleString('vi-VN') %>đ
      </td>

      <td>
        <b><%= Number(i.line_total).toLocaleString('vi-VN') %>đ</b>
      </td>
    </tr>
  <% }) %>

  <tr>
    <th colspan="3">Tạm tính</th>
    <th><%= Number(order.total_amount).toLocaleString('vi-VN') %>đ</th>
  </tr>

  <tr>
    <th colspan="3">Dùng điểm</th>
    <th>
      <%= order.points_used || 0 %> điểm -
      giảm <%= Number(order.discount_amount || 0).toLocaleString('vi-VN') %>đ
    </th>
  </tr>
</table>

<form
  method="post"
  action="/orders/<%= order.id %>/pay"
  class="form-inline card validate-payment-form"
  id="paymentForm"
>
  <select name="method" id="paymentMethod" required>
    <option value="">-- Chọn phương thức thanh toán --</option>
    <option value="BANKING">BANKING</option>
    <option value="MOMO">MOMO</option>
    <option value="VNPAY">VNPAY</option>
  </select>

  <button type="submit">Thanh toán ngay</button>
</form>

<script>
  const toast = document.getElementById('toast');
  const toastMessage = document.getElementById('toastMessage');

  function showToast(message, type = 'success') {
    toast.className = `toast ${type}`;
    toastMessage.textContent = message;

    setTimeout(() => {
      closeToast();
    }, 3500);
  }

  function closeToast() {
    toast.className = 'toast hidden';
  }

  const paymentForm = document.getElementById('paymentForm');
  const paymentMethod = document.getElementById('paymentMethod');

  paymentForm.addEventListener('submit', function (e) {
    paymentMethod.classList.remove('input-error');

    if (!paymentMethod.value) {
      e.preventDefault();
      paymentMethod.classList.add('input-error');
      showToast('Vui lòng chọn phương thức thanh toán.', 'error');
      return;
    }

    const ok = confirm('Bạn có chắc muốn thanh toán đơn hàng này không?');

    if (!ok) {
      e.preventDefault();
    }
  });

  const params = new URLSearchParams(window.location.search);

  if (params.get('success')) {
    showToast(params.get('success'), 'success');
  }

  if (params.get('error')) {
    showToast(params.get('error'), 'error');
  }
</script>

<%- include('partials/footer') %>