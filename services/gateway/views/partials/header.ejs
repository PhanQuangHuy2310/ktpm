<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Coffee Chain</title>
  <link rel="stylesheet" href="/style.css">
  <style>
    :root{--bg:#f7efe4;--paper:#fffaf3;--card:#fffdf8;--ink:#2b1b12;--muted:#856b5a;--brand:#6f3f22;--brand2:#a96b3c;--gold:#d6a14a;--line:#ead9c5;--danger:#b42318;--success:#20744a;--shadow:0 18px 50px rgba(68,38,18,.12);--radius:22px}*{box-sizing:border-box}body{margin:0;font-family:Inter,ui-sans-serif,system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;background:radial-gradient(circle at top left,#fff7ed 0,#f7efe4 38%,#efe0cd 100%);color:var(--ink)}a{color:var(--brand);font-weight:800;text-decoration:none}a:hover{text-decoration:underline}.nav{position:sticky;top:0;z-index:50;display:grid;grid-template-columns:auto 1fr auto;gap:18px;align-items:center;padding:14px 28px;background:rgba(43,27,18,.94);backdrop-filter:blur(14px);box-shadow:0 16px 40px rgba(30,18,10,.22);color:#fff}.brand{display:flex;align-items:center;gap:10px;font-size:21px;font-weight:950;letter-spacing:-.02em}.brand:before{content:'☕';display:grid;place-items:center;width:42px;height:42px;border-radius:15px;background:linear-gradient(135deg,#d6a14a,#8d512c);box-shadow:inset 0 0 0 1px rgba(255,255,255,.18)}.top-meta{justify-self:center;display:flex;gap:10px;align-items:center;flex-wrap:wrap;color:#f9e8d2;font-size:13px}.top-meta span{padding:8px 12px;border-radius:999px;background:rgba(255,255,255,.09);border:1px solid rgba(255,255,255,.13)}.links{display:flex;gap:8px;align-items:center;justify-content:flex-end;flex-wrap:wrap}.links a{color:#fff;padding:9px 12px;border-radius:999px;font-size:13px;background:rgba(255,255,255,.07);border:1px solid transparent}.links a:hover{background:#fff;color:var(--brand);text-decoration:none}.container{width:min(1240px,calc(100% - 36px));margin:28px auto 54px}.page-head,.hero{position:relative;overflow:hidden;display:flex;justify-content:space-between;align-items:flex-end;gap:20px;margin-bottom:22px;padding:26px;border-radius:30px;background:linear-gradient(135deg,#3a2317 0%,#7a4324 58%,#c8904c 100%);color:#fff;box-shadow:var(--shadow)}.page-head:after,.hero:after{content:'';position:absolute;right:-70px;top:-80px;width:260px;height:260px;border-radius:50%;background:rgba(255,255,255,.13)}h1{margin:0 0 16px;font-size:34px;line-height:1.08;letter-spacing:-.04em}.page-head h1,.hero h1{margin:0;color:#fff}.page-head p,.hero p{margin:8px 0 0;color:#f8e4cd;max-width:720px}.eyebrow{display:inline-flex;align-items:center;gap:8px;margin-bottom:10px;padding:7px 12px;border-radius:999px;background:rgba(255,255,255,.14);border:1px solid rgba(255,255,255,.18);font-weight:900;font-size:12px;text-transform:uppercase;letter-spacing:.08em}h2{margin:0 0 16px;font-size:22px;letter-spacing:-.03em}h3{margin:0 0 8px}p{line-height:1.6}.card{background:rgba(255,253,248,.92);border:1px solid rgba(234,217,197,.92);border-radius:var(--radius);padding:20px;box-shadow:var(--shadow);margin-bottom:18px}.grid{display:grid;gap:18px}.cards{grid-template-columns:repeat(auto-fit,minmax(210px,1fr))}.cards .card{position:relative;overflow:hidden}.cards .card:before{content:'';position:absolute;right:-28px;top:-30px;width:92px;height:92px;border-radius:50%;background:#f1d7b8}.cards b{display:block;font-size:30px;color:var(--brand);letter-spacing:-.05em}.two{display:grid;grid-template-columns:1.2fr .8fr;gap:20px;align-items:start}.form-inline{display:flex;gap:12px;align-items:center;flex-wrap:wrap}.toolbar{position:sticky;top:84px;z-index:10}label{display:block;margin:10px 0 7px;font-weight:850;color:#503523}input,select,textarea{width:100%;border:1px solid #e1cdb7;background:#fffaf5;color:var(--ink);border-radius:15px;padding:12px 14px;font:inherit;outline:none;transition:.18s}input:focus,select:focus,textarea:focus{border-color:#b97948;box-shadow:0 0 0 4px rgba(169,107,60,.13)}textarea{min-height:94px;resize:vertical}.form-inline input,.form-inline select{width:auto;min-width:170px}button,.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;border:0;border-radius:15px;padding:12px 16px;background:linear-gradient(135deg,var(--brand),var(--brand2));color:#fff!important;font-weight:950;cursor:pointer;box-shadow:0 12px 24px rgba(111,63,34,.22);text-decoration:none!important;white-space:nowrap}.btn.light,button.light{background:#fff;color:var(--brand)!important;border:1px solid #e4d0bb;box-shadow:none}.danger{background:linear-gradient(135deg,#b42318,#d14c3f)!important}.primary{width:100%;font-size:16px;padding:15px 18px}.alert,.success{padding:14px 16px;border-radius:18px;margin:16px 0;border:1px solid}.alert{background:#fff1f0;color:#8d1d16;border-color:#ffd1cc}.success{background:#eefaf3;color:#145c39;border-color:#bee8cf}.badge,.pill{display:inline-flex;align-items:center;justify-content:center;border-radius:999px;padding:6px 10px;background:#f4e1c9;color:#6f3f22;font-weight:950;font-size:12px}.muted,small{color:var(--muted)}table{width:100%;border-collapse:separate;border-spacing:0;margin:16px 0;background:rgba(255,253,248,.96);border:1px solid var(--line);border-radius:22px;overflow:hidden;box-shadow:var(--shadow)}th,td{padding:14px 15px;text-align:left;border-bottom:1px solid #efdfcd;vertical-align:middle}th{background:#3a2317;color:#fff;font-size:12px;text-transform:uppercase;letter-spacing:.06em}tr:last-child td{border-bottom:0}tr:hover td{background:#fff7ed}td form{display:inline-flex;gap:8px;align-items:center;margin:2px}.thumb{width:72px;height:58px;object-fit:cover;border-radius:16px;border:1px solid #ead9c5}.shop-hero{min-height:220px;background:linear-gradient(115deg,rgba(58,35,23,.94),rgba(111,63,34,.86)),url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?w=1400') center/cover}.point-card,.total-box{min-width:230px;padding:20px;border-radius:24px;background:rgba(255,255,255,.16);border:1px solid rgba(255,255,255,.22);backdrop-filter:blur(10px)}.point-card b,.total-box b{display:block;font-size:32px;color:#fff}.product-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:18px}.product-card,.product-mini{overflow:hidden;border:1px solid var(--line);border-radius:22px;background:#fff;box-shadow:0 12px 28px rgba(68,38,18,.08)}.product-card img{width:100%;height:150px;object-fit:cover}.product-info{padding:15px}.product-info p{color:var(--muted);min-height:46px}.product-info strong{display:block;margin:10px 0;font-size:20px;color:var(--brand)}.buy-row{display:flex;align-items:center;gap:10px;justify-content:space-between}.buy-row label{margin:0}.buy-row .qty{max-width:84px}.address-box{display:flex;gap:10px}.cart-card{position:sticky;top:156px}.products{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:14px}.product-mini{display:grid;grid-template-columns:70px 1fr auto 72px;align-items:center;gap:12px;padding:10px}.product-mini img{width:70px;height:64px;object-fit:cover;border-radius:16px}.checkout-card{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-bottom:18px;padding:24px;border-radius:30px;background:linear-gradient(135deg,#3a2317,#81502c);color:#fff;box-shadow:var(--shadow)}.checkout-card p{color:#f9e8d2}.point-big{background:linear-gradient(135deg,#fffdf8,#f6dfbf)}.barline{display:grid;grid-template-columns:1fr minmax(80px,45%) 50px;gap:10px;align-items:center;margin:12px 0}.barline b{display:block;height:12px;border-radius:999px;background:linear-gradient(90deg,#d6a14a,#6f3f22);min-width:8px}.chart-bars{height:245px;display:flex;align-items:flex-end;gap:14px;overflow:auto;padding:18px 8px}.bar-col{min-width:70px;display:flex;flex-direction:column;align-items:center;gap:8px}.bar-col span{width:34px;border-radius:12px 12px 4px 4px;background:linear-gradient(180deg,#d6a14a,#6f3f22)}.donut-list{display:grid;gap:10px}.donut-row{display:grid;grid-template-columns:auto 1fr auto auto;gap:8px;align-items:center}.dot{width:12px;height:12px;border-radius:999px;background:var(--brand)}.donut{display:grid;place-items:center;margin-top:18px}.donut>div{width:170px;height:170px;border-radius:50%;position:relative}.donut>div:after{content:'';position:absolute;inset:38px;border-radius:50%;background:var(--card)}.thank{text-align:center;max-width:720px;margin:70px auto;padding:44px;border-radius:34px;background:#fffdf8;box-shadow:var(--shadow);border:1px solid var(--line)}.actions{display:flex;gap:12px;justify-content:center;flex-wrap:wrap;margin-top:20px}.footer{width:min(1240px,calc(100% - 36px));margin:36px auto 24px;color:var(--muted);text-align:center}.invoice-body{background:#f8f1e8}.invoice{max-width:860px;margin:30px auto;padding:32px;border-radius:28px;background:#fff;box-shadow:var(--shadow)}.center{text-align:center}.right{text-align:right}.receipt-table{box-shadow:none}.words{margin-top:24px;color:var(--muted)}@media(max-width:900px){.nav{grid-template-columns:1fr}.top-meta{justify-self:start}.links{justify-content:flex-start}.two{grid-template-columns:1fr}.page-head,.hero,.checkout-card{display:block}.cart-card,.toolbar{position:static}.form-inline input,.form-inline select{width:100%}.product-mini{grid-template-columns:64px 1fr}.product-mini input{width:100%}}
  </style>
</head>
<body>
<nav class="nav">
  <div class="brand">Coffee Chain</div>
  <div class="top-meta"><span id="clock"></span><% if(user?.branchName){ %><span><%= user.branchName %></span><% } %></div>
  <div class="links">
    <% if(user?.role==='customer'){ %>
      <a href="/customer">Trang chủ</a><a href="/customer/points">Xem điểm</a><a href="/customer/orders">Hàng đã mua</a><a href="/logout">Đăng xuất</a>
    <% } else { %>
      <a href="/dashboard">Tổng quan</a><% if(user?.role==='admin'){ %><a href="/branches">Chi nhánh</a><% } %><% if(['admin','manager'].includes(user?.role)){ %><a href="/users">Tài khoản</a><a href="/employees">Nhân viên</a><a href="/menu">Menu/Giá</a><% } %><a href="/orders">Lịch sử order</a><% if(user?.role==='staff'){ %><a href="/orders/new">Bán hàng</a><% } %><a href="/customers">Khách hàng</a><a href="/reports">Doanh thu</a><a href="/logout">Đăng xuất</a>
    <% } %>
  </div>
</nav>
<main class="container">
<script>function tick(){const el=document.getElementById('clock');if(!el)return;const now=new Date();const date=new Intl.DateTimeFormat('vi-VN',{timeZone:'Asia/Ho_Chi_Minh',weekday:'long',day:'2-digit',month:'2-digit',year:'numeric'}).format(now);const time=new Intl.DateTimeFormat('vi-VN',{timeZone:'Asia/Ho_Chi_Minh',hour:'2-digit',minute:'2-digit',second:'2-digit',hour12:false}).format(now);el.textContent=date+' '+time+' (HoChiMinh)';}tick();setInterval(tick,1000);</script>
